{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boon-advisor.local/schemas/runtime-attestations.schema.json",
  "title": "Hades II runtime attestations catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "nativeItems",
    "offerSources",
    "sourceBoonPairs",
    "externalNameMappings",
    "evidence"
  ],
  "properties": {
    "$schema": { "const": "./runtime_attestations.schema.json" },
    "schemaVersion": { "const": 1 },
    "nativeItems": {
      "type": "array",
      "items": { "$ref": "#/$defs/nativeItem" }
    },
    "offerSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/offerSource" }
    },
    "sourceBoonPairs": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceBoonPair" }
    },
    "externalNameMappings": {
      "type": "array",
      "items": { "$ref": "#/$defs/externalNameMapping" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]+$" },
    "status": {
      "description": "Status of this exact attested claim. Freshness tooling reports staleness but never rewrites this value.",
      "enum": ["validated", "needs_revalidation", "invalid", "deprecated"]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "predicate", "value", "status", "evidenceIds"],
      "properties": {
        "claimId": { "$ref": "#/$defs/id" },
        "predicate": { "enum": ["nativeType", "nativeSlot", "sourceType"] },
        "value": { "type": ["string", "number", "boolean"] },
        "status": { "$ref": "#/$defs/status" },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" },
          "minItems": 1
        }
      }
    },
    "nativeItemClaim": {
      "allOf": [
        { "$ref": "#/$defs/claim" },
        { "properties": { "predicate": { "enum": ["nativeType", "nativeSlot"] } } }
      ]
    },
    "sourceClaim": {
      "allOf": [
        { "$ref": "#/$defs/claim" },
        { "properties": { "predicate": { "const": "sourceType" } } }
      ]
    },
    "nativeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeItemId", "claims"],
      "properties": {
        "runtimeItemId": { "$ref": "#/$defs/id" },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nativeItemClaim" }
        }
      }
    },
    "offerSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offerSource", "claims"],
      "properties": {
        "offerSource": { "$ref": "#/$defs/id" },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceClaim" }
        }
      }
    },
    "sourceBoonPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairId", "offerSource", "runtimeItemId", "claimId", "status", "evidenceIds"],
      "properties": {
        "pairId": { "$ref": "#/$defs/id" },
        "offerSource": { "$ref": "#/$defs/id" },
        "runtimeItemId": { "$ref": "#/$defs/id" },
        "claimId": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/status" },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" },
          "minItems": 1
        }
      }
    },
    "externalNameMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mappingId", "provider", "externalName", "runtimeItemId", "claimId", "status", "evidenceIds"],
      "properties": {
        "mappingId": { "$ref": "#/$defs/id" },
        "provider": { "type": "string", "minLength": 1 },
        "externalName": { "type": "string", "minLength": 1 },
        "runtimeItemId": { "$ref": "#/$defs/id" },
        "claimId": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/status" },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" },
          "minItems": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "evidenceKind", "attests", "stableReference", "method", "reviewedAt"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/id" },
        "evidenceKind": {
          "enum": ["Hades2NativeFile", "MobalyticsPage", "MobalyticsCDN", "Documentary"]
        },
        "attests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "gameBuild": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "minLength": 1 },
        "stableReference": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "evidenceKind": { "const": "Hades2NativeFile" } }, "required": ["evidenceKind"] },
          "then": { "required": ["gameBuild", "filePath", "sha256"] }
        }
      ]
    }
  }
}
